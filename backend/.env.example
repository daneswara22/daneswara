# Copy to .env (dev) or set these in Coolify (production).

# MariaDB - Coolify internal URL (same Docker network) or public host:port
DATABASE_URL=mysql://daneswaraprod:CHANGE_ME@e5t5yllm46db0cnsu9fwv3cv:3306/default

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=true

# First-run owner account (only created when no Owner exists)
OWNER_USERNAME=admin
OWNER_PASSWORD=CHANGE_ME
OWNER_NAME=Owner
OWNER_BUSINESS=Daneswara Print

# Seed demo/catalog data on empty DB (set false when migrating from Mongo)
SEED_CATALOG=true
SEED_CUSTOMERS=true
SEED_GALLERY=true

# Timezone for "today"/reports
TIMEZONE=Asia/Makassar
CORS_ORIGINS=*

# Public origin of the site (used for local-upload fallback URLs: {PUBLIC_BASE_URL}/api/files/...)
PUBLIC_BASE_URL=https://daneswaraprint.com

# Cloudflare R2 (S3 API). Leave R2_BUCKET empty to store uploads on local disk (/data/uploads volume).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
R2_PREFIX=daneswara
