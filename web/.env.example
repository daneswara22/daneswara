# Copy to .env and fill actual values (NEVER commit .env)
DATABASE_URL=mysql://mariadb:PASSWORD@103.175.220.31:6796/default

JWT_SECRET=long-random-string
OWNER_USERNAME=admin
OWNER_PASSWORD=ChangeMe123!
TIMEZONE=Asia/Makassar
PUBLIC_BASE_URL=https://daneswara.com

# Kanal penjualan (Shopee Open Platform V2)
# Basis URL publik untuk Redirect URL & Push/Webhook URL yang didaftarkan di
# Shopee Console. Harus HTTPS dan bisa dijangkau dari internet (jangan
# 0.0.0.0/localhost). Kosongkan untuk memakai PUBLIC_BASE_URL.
CHANNEL_PUBLIC_BASE_URL=https://daneswara.com
# Opsional: paksa environment Shopee dari server -> sandbox | live
SHOPEE_ENVIRONMENT=sandbox
# Opsional: kunci enkripsi rahasia kanal (64 hex). Default diturunkan dari JWT_SECRET.
CHANNEL_ENC_KEY=

# Cloudflare R2 - leave R2_BUCKET empty to fall back to disk /data/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_PREFIX=daneswara

UPLOAD_DIR=/data/uploads

# Seed flags
SEED_CATALOG=true
SEED_CUSTOMERS=true
SEED_GALLERY=true
